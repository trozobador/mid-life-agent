# Pessoa ativa (ricardo | carol | ...) — usada quando --person não é passado na CLI
PERSON=ricardo

# Provedor de LLM ativo (openai | anthropic | gemini | grok) — padrão: openai
LLM_PROVIDER=openai

# ChatGPT
OPENAI_API_KEY=

# Claude
ANTHROPIC_API_KEY=

# Gemini (o código lê GOOGLE_API_KEY, não GEMINI_API_KEY)
GOOGLE_API_KEY=

# Grok (xAI)
XAI_API_KEY=
